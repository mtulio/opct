---
extends: default

rules:
  line-length:
    max: 180
    level: warning
  document-start: disable
  comments:
    min-spaces-from-content: 1
    level: warning
  comments-indentation:
    level: warning
  indentation:
    spaces: 2
    indent-sequences: true
    level: warning
  truthy:
    allowed-values: ['true', 'false', 'on', 'off']
